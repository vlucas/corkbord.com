DATABASE_URL=postgres://localhost:5432/corkbord
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://corkbord.localhost:1355

# Optional — AI previews fall back to rule-based formatting without this
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# X (Twitter) OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn OAuth 2.0 — personal: enable Share on LinkedIn + Sign In with OpenID Connect.
# Company pages: also apply for Community Management API in the LinkedIn Developer Portal.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202601

# Encrypt channel OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=change-me-32-char-minimum-secret!!
